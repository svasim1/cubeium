# Normalize all text files to LF in the repository; each checkout picks its
# native line endings (CRLF on Windows with core.autocrlf, LF elsewhere).
* text=auto

# Linux start script must use LF
/gradlew        text eol=lf

# Windows scripts should use CRLF
*.bat           text eol=crlf

# Binaries
*.dll           binary
*.so            binary
*.dylib         binary
*.png           binary
*.jar           binary
